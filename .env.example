# EpiScope Environment Variables
# Copy this file to .env and fill in your values

# Salt for patient ID hashing (REQUIRED — keep secret, not in Git)
EPISCOPE_SALT=your_secret_salt_here

# Scale factor (0.25 for dev, 1.0 for full)
EPISCOPE_SF=0.25

# Random seed for deterministic generation
EPISCOPE_SEED=42
